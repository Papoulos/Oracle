# --- Configuration LLM (Texte) ---
# Provider: "ollama" ou "openai" (pour llama-cpp ou autre API compatible)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:26b

# --- Configuration Embeddings ---
# Provider: "ollama" ou "openai"
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# --- Configuration par Agent ---
CHARACTER_MODEL=gemma4:26b
CHARACTER_TEMP=0.7

NARRATOR_MODEL=gemma4:26b
NARRATOR_TEMP=0.7

ORCHESTRATOR_MODEL=gemma4:26b
ORCHESTRATOR_TEMP=0.7

# Modèle léger recommandé pour la chronique pour optimiser le TTFT
CHRONICLE_MODEL=qwen2.5-coder:7b
CHRONICLE_TEMP=0.1

# --- Configuration Serveur ---
SERVER_ADDRESS=localhost
SERVER_PORT=8501

# Modèle léger recommandé pour la fiche pour optimiser le TTFT
SHEET_MANAGER_MODEL=qwen2.5-coder:7b
SHEET_MANAGER_TEMP=0.1

# --- Chemins et VectorDB ---
CHROMA_PATH=./chroma_db
CORE_DATA_PATH=./data/core
SCENARIO_DATA_PATH=./data/scenario
CORE_COLLECTION_NAME=core_collection
SCENARIO_COLLECTION_NAME=scenario_collection

# --- RAG ---
RAG_SEARCH_K=12
RAG_K_ADVENTURE=3
RAG_K_SETUP=8
RAG_K_CREATION=8
SCENARIO_FULLTEXT_THRESHOLD_CHARS=40000
CORE_FULLTEXT_THRESHOLD_CHARS=40000

# --- Compatibilité Ollama (Anciennes variables) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_EMBED_MODEL=nomic-embed-text
