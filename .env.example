# --- Configuration LLM (Texte) ---
# Provider: "ollama", "openai", "anthropic", ou "gemini"
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:26b

# --- Configuration Embeddings ---
# Provider: "ollama", "openai", ou "gemini"
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# --- Clés d'API (Google, Anthropic, OpenAI) ---
# Nécessaire si le provider correspondant est utilisé
OPENAI_API_KEY=votre_cle_openai
ANTHROPIC_API_KEY=votre_cle_claude
GEMINI_API_KEY=votre_cle_gemini

# --- Configuration par Agent ---
CHARACTER_MODEL=gemma4:26b
CHARACTER_TEMP=0.7

NARRATOR_MODEL=gemma4:26b
NARRATOR_TEMP=0.7

ORCHESTRATOR_MODEL=gemma4:26b
ORCHESTRATOR_TEMP=0.7

CHRONICLE_MODEL=gemma4:26b
CHRONICLE_TEMP=0.1


# --- Options avancées du LLM (Provider Ollama) ---
# LLM_REASONING : active/désactive le reasoning pour tous les agents.
# Valeurs : "true", "false", "default" (laisse le modèle décider) ou absente (None).
# LLM_KEEP_ALIVE : durée de maintien en mémoire (ex. "30m"). Si absente, comportement par défaut d'Ollama.
# LLM_REASONING=default
# LLM_KEEP_ALIVE=5m

# --- Configuration de l'Extracteur de Pack ---
# PACK_NUM_CTX : taille de contexte pour PackExtractorAgent (défaut : 32768)
# PACK_NUM_PREDICT : limite de jetons de réponse (défaut : 16384)
# PACK_REASONING : active/désactive le reasoning pour l'extracteur.
# "false" par défaut (pour éviter les erreurs de génération trop longues).
# Prend le pas sur LLM_REASONING. "default" désactive la surcharge.
# PACK_EXTRACTOR_TEMP : température pour l'extraction de pack (défaut : 0.1)
# PACK_NUM_CTX=32768
# PACK_NUM_PREDICT=16384
# PACK_REASONING=false
# PACK_EXTRACTOR_TEMP=0.1

# --- Configuration Serveur ---
SERVER_ADDRESS=localhost
SERVER_PORT=8501

SHEET_MANAGER_MODEL=gemma3
SHEET_MANAGER_TEMP=0.1

# --- Chemins et VectorDB ---
SYSTEM_PACK=dnd5e_srd
CHROMA_PATH=./chroma_db
CORE_DATA_PATH=./data/core
SCENARIO_DATA_PATH=./data/scenario
CORE_COLLECTION_NAME=core_collection
SCENARIO_COLLECTION_NAME=scenario_collection

# --- RAG ---
RAG_SEARCH_K=12
RAG_K_ADVENTURE=5
RAG_K_SETUP=8
RAG_K_CREATION=8
SCENARIO_FULLTEXT_THRESHOLD_CHARS=40000
CORE_FULLTEXT_THRESHOLD_CHARS=40000

# --- Compatibilité Ollama (Anciennes variables) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_EMBED_MODEL=nomic-embed-text
